{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:up": {
      "cache": false
    },
    "db:down": {
      "cache": false
    }
  }
}
